# Rooted Daily - AI API Configuration
# ==================================
# The app supports multiple AI providers with automatic fallback.
# Add at least ONE API key below. The app will try them in order:
# 1. Groq (via Cloudflare Worker - fastest, free tier available)
# 2. Google Gemini (fallback - free tier available)
# 3. OpenAI (fallback)
# 4. Anthropic Claude (fallback)

# Groq AI Proxy (Primary - RECOMMENDED)
# Sign up at: https://console.groq.com
# This uses a Cloudflare Worker proxy for security
EXPO_PUBLIC_AI_PROXY_URL=https://rooted-ai.mattjhagen.workers.dev

# Google Gemini (Fallback - FREE TIER AVAILABLE)
# Get your API key at: https://makersuite.google.com/app/apikey
# Free tier: 15 requests per minute, 1500 per day
EXPO_PUBLIC_GEMINI_API_KEY=

# OpenAI (Fallback)
# Get your API key at: https://platform.openai.com/api-keys
# Paid service - requires credit card
EXPO_PUBLIC_OPENAI_API_KEY=

# Anthropic Claude (Fallback)
# Get your API key at: https://console.anthropic.com/
# Paid service - requires credit card
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# ==================================
# QUICK START GUIDE:
# ==================================
# 1. Choose ONE provider (Gemini is recommended for free tier)
# 2. Click the link above to get your API key
# 3. Paste it after the equals sign (no quotes needed)
# 4. Save this file
# 5. Restart your Expo development server
#
# Example:
# EXPO_PUBLIC_GEMINI_API_KEY=AIzaSyABC123def456GHI789jkl
#
# ==================================

# ==================================
# OPTIONAL SERVICES
# ==================================
# These services add extra features but are NOT required for core functionality.
# The app works fine without them!

# Supabase (Optional - for community features)
# Sign up at: https://supabase.com
# Required for: User authentication, community chat, devotionals sync, journal sync
# Without it: App still works - journal saves locally, no community features
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# OAuth Configuration (Supabase Dashboard)
# After creating your Supabase project:
# 1. Go to Authentication > Providers
# 2. Enable Google and/or Apple Sign-in
# 3. Add OAuth credentials from Google Cloud Console / Apple Developer
# 4. Set redirect URL to: deenbuddy://auth/callback

# YouVersion API (Optional - for dynamic verse of the day)
# Apply at: https://www.youversion.com/developer
# Required for: Daily verse of the day feature
# Without it: Shows John 3:16 as fallback verse, all other features work
EXPO_PUBLIC_YOUVERSION_API_KEY=

# YouVersion OAuth (Optional - for Sign in with YouVersion)
# Required for: YouVersion OAuth sign-in
# Get from: https://developers.youversion.com/api/data-exchange
EXPO_PUBLIC_YOUVERSION_CLIENT_ID=
EXPO_PUBLIC_YOUVERSION_CLIENT_SECRET=

# ==================================
# WHAT WORKS WITHOUT OPTIONAL SERVICES?
# ==================================
# ✅ Bible reading (all 66 books, 1,189 chapters)
# ✅ AI chat for verse reflection (requires AI key above)
# ✅ Journal (saves locally)
# ✅ Reading plans with progress tracking
# ✅ Verse highlighting and bookmarks
# ✅ Audio Bible playback
# ✅ Offline access to all Bible content
#
# ❌ Community features (requires Supabase)
# ❌ Dynamic verse of the day (requires YouVersion)
# ❌ Cross-device sync (requires Supabase)
